# Copy to .env (docker compose reads it) or set in your host's dashboard.
NODE_ENV=production
PORT=3000
# Public https URL customers will reach. Baked into every QR code!
BASE_URL=https://menu.vignadigital.com
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Super admin, created on first start only
ADMIN_EMAIL=admin@vignadigital.com
ADMIN_PASSWORD=
# Where the database and uploads are stored (mount a persistent volume here)
DATA_DIR=/data
# Number of reverse-proxy hops in front of the app (default 1)
# TRUST_PROXY=1
# Shown as a "Get your menu" / "Contact us" button on the landing page (optional)
CONTACT_EMAIL=hello@vignadigital.com
