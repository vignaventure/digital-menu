<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= r.name %> · Menu</title><link rel="stylesheet" href="/style.css"></head><body>
<div class="menu-head"><h1><%= r.name %></h1></div>
<% if (!sections.length) { %><p class="empty">Menu coming soon.</p><% } else { %>
<nav class="tabs" id="tabs">
  <% sections.forEach(s => { %><a href="#cat-<%= s.id %>"><%= s.name %></a><% }) %>
</nav>
<main class="menu">
  <% sections.forEach(s => { %>
    <h2 id="cat-<%= s.id %>"><%= s.name %></h2>
    <div class="cards">
      <% s.items.forEach(i => { %>
        <article class="card">
          <% if (i.image) { %><img loading="lazy" src="/uploads/<%= i.image %>" alt="<%= i.name %>"><% } else { %><div class="noimg"></div><% } %>
          <div class="body"><h3><%= i.name %></h3>
            <% if (i.description) { %><p><%= i.description %></p><% } %>
            <div class="price"><%= Number(i.price).toFixed(2) %></div></div>
        </article>
      <% }) %>
    </div>
  <% }) %>
</main>
<script>
// highlight the category chip for the section currently in view
const links=[...document.querySelectorAll('#tabs a')];
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){
  links.forEach(l=>l.classList.toggle('on',l.getAttribute('href')==='#'+e.target.id));
  document.querySelector('#tabs a.on')?.scrollIntoView({inline:'center',block:'nearest'});}}),{rootMargin:'-20% 0px -70% 0px'});
document.querySelectorAll('.menu h2').forEach(h=>io.observe(h));
</script>
<% } %></body></html>
