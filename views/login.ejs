<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Login · Menu Card</title><link rel="stylesheet" href="/style.css"></head><body>
<form class="panel login" method="post" action="/login">
  <h1>Menu Card</h1><p style="color:var(--mute)">Sign in to your dashboard</p>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <label>Email</label><input type="email" name="email" required autofocus>
  <label>Password</label><input type="password" name="password" required>
  <p><button style="width:100%">Sign in</button></p>
</form></body></html>
