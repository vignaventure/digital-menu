<% const today = new Date().toISOString().slice(0, 10);
   const activeCount = rows.filter(r => r.active).length;
   const revenue = rows.reduce((s, r) => s + (r.price_paid || 0), 0);
   const totalItems = rows.reduce((s, r) => s + (r.item_count || 0), 0);
   // form values: re-filled submission > restaurant being edited > blank defaults
   const f = form || (edit
     ? { name: edit.name, mobile: edit.mobile || '', email: edit.email || '', price_paid: edit.price_paid,
         plan_type: edit.plan_expires ? 'limited' : 'one_time', plan_expires: edit.plan_expires || '' }
     : { plan_type: 'one_time', price_paid: 0 });
   const limited = (f.plan_type || (f.plan_expires ? 'limited' : 'one_time')) === 'limited'; %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin · Vigna Digital Menu</title>
<link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/app.css"></head><body class="app">

<header class="app-bar"><div class="app-wrap full">
  <a class="app-brand" href="/admin"><i class="mark">▦</i><span>Vigna Digital Menu<small>Super admin</small></span></a>
  <div class="app-actions">
    <button type="button" class="cta" id="open-onboard">+ <span class="hide-sm">Onboard restaurant</span><span class="show-sm">Onboard</span></button>
    <form method="post" action="/logout"><button class="ghost">Logout</button></form>
  </div>
</div></header>

<main class="app-wrap full">
  <div class="app-title"><h1>Restaurants</h1><p>Onboard new customers and manage their accounts.</p></div>

  <div class="stats">
    <div class="stat hl"><b><%= rows.length %></b><span>Total restaurants</span></div>
    <div class="stat"><b><%= activeCount %></b><span>Active</span></div>
    <div class="stat"><b><%= revenue.toLocaleString() %></b><span>Total paid</span></div>
    <div class="stat"><b><%= totalItems %></b><span>Menu items</span></div>
  </div>

  <% if (credentials) { %>
  <section class="box creds" id="creds">
    <h2><span>✓ <%= credentials.title %>: <%= credentials.name %></span><button type="button" class="sm" id="copycreds">Copy details</button></h2>
    <dl>
      <div><dt>Login page</dt><dd id="c-url"><%= base %>/login</dd></div>
      <div><dt>Mobile</dt><dd id="c-mobile"><%= credentials.mobile || '—' %></dd></div>
      <% if (credentials.email) { %><div><dt>Email</dt><dd id="c-email"><%= credentials.email %></dd></div><% } %>
      <div><dt>Password</dt><dd id="c-pass" class="mono"><%= credentials.password %></dd></div>
    </dl>
    <p class="hint">Share these with the owner now. The password is shown only this once and cannot be looked up later. Use <b>Reset password</b> to generate a new one at any time.</p>
  </section>
  <% } %>

  <% const formOpen = !!(edit || form || error || openForm); %>
  <dialog class="formdlg" id="onboard-dlg" aria-labelledby="dlg-title">
    <div class="dlg-head">
      <h2 id="dlg-title"><%= edit ? 'Edit restaurant' : 'Onboard restaurant' %><% if (edit) { %><small><%= edit.name %></small><% } %></h2>
      <button type="button" class="ghost sm dlg-x" data-dlg-close aria-label="Close">✕</button>
    </div>
    <form method="post" action="<%= edit ? '/admin/restaurants/' + edit.id : '/admin/restaurants' %>" autocomplete="off">
      <div class="dlg-body">
        <% if (error) { %><div class="flash err" role="alert"><%= error %></div><% } %>
        <div class="fgrid">
          <div class="f"><label for="name">Restaurant name</label>
            <input id="name" name="name" required value="<%= f.name || '' %>"></div>

          <div class="f"><label for="mobile">Owner mobile <small class="req" title="Used as the owner's login">required</small></label>
            <input id="mobile" type="tel" name="mobile" inputmode="tel" placeholder="e.g. 9876543210 or +919876543210" required value="<%= f.mobile || '' %>"></div>

          <div class="f"><label for="email">Owner email <small class="opt">optional</small></label>
            <input id="email" type="email" name="email" placeholder="owner@restaurant.com" value="<%= f.email || '' %>"></div>

          <div class="f"><label for="password"><%= edit ? 'New password' : 'Password' %> <small class="opt"><%= edit ? 'blank = keep current' : 'min 6 characters' %></small></label>
            <div class="pwrow">
              <input id="password" name="password" minlength="6" <%= edit ? '' : 'required' %> placeholder="<%= edit ? 'Unchanged' : 'Type or generate' %>">
              <button type="button" class="ghost sm" id="genpw">Generate</button>
              <button type="button" class="ghost sm" id="cppw">Copy</button>
            </div></div>

          <div class="f"><label for="price_paid">Price paid</label>
            <input id="price_paid" type="number" name="price_paid" min="0" step="0.01" value="<%= f.price_paid ?? 0 %>"></div>

          <div class="f"><label>Plan</label>
            <div class="seg" role="radiogroup" aria-label="Plan type">
              <label><input type="radio" name="plan_type" value="one_time" <%= limited ? '' : 'checked' %>><span>One time</span></label>
              <label><input type="radio" name="plan_type" value="limited" <%= limited ? 'checked' : '' %>><span>Limited</span></label>
            </div>
            <p class="hint" id="planhint" style="margin-top:6px"><%= limited ? 'Menu stops working after the valid-until date.' : 'One-time plans never expire.' %></p></div>

          <div class="f" id="validwrap" style="<%= limited ? '' : 'display:none' %>"><label for="plan_expires">Valid until</label>
            <input id="plan_expires" type="date" name="plan_expires" value="<%= f.plan_expires || '' %>" <%= limited ? 'required' : '' %>></div>
        </div>
      </div>
      <div class="dlg-foot">
        <button type="button" class="ghost" data-dlg-close>Cancel</button>
        <button><%= edit ? 'Save changes' : 'Create account' %></button>
      </div>
    </form>
  </dialog>

  <section class="box tablebox">
    <h2>All restaurants <small><%= rows.length %> total</small></h2>
    <% if (ok) { %><div class="flash ok"><%= ok %></div><% } %>
    <% if (!rows.length) { %>
      <div class="empty"><b>No restaurants yet</b>Click <b>+ Onboard restaurant</b> to add your first customer.</div>
    <% } else { %>
    <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th>Restaurant</th><th>Mobile</th><th>Email</th><th>Password</th><th>Plan</th><th>Paid</th><th>Items</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
      <% rows.forEach(r => { const expired = r.plan_expires && r.plan_expires < today; %>
        <tr class="<%= edit && edit.id === r.id ? 'sel' : '' %> <%= r.active ? '' : 'inactive' %>">
          <td data-label="Restaurant" class="t-name">
            <div class="avatar"><%= r.name.charAt(0) %></div>
            <a href="/m/<%= r.slug %>" target="_blank" rel="noopener"><%= r.name %> ↗</a>
          </td>
          <td data-label="Mobile"><%= r.mobile || '—' %></td>
          <td data-label="Email" class="t-email"><%= r.email || '—' %></td>
          <td data-label="Password" class="t-pw">
            <% if (r.has_password) { %>
              <span class="pwtxt" id="pw-<%= r.id %>">••••••••</span>
              <button type="button" class="eye" data-id="<%= r.id %>" aria-pressed="false" aria-label="Show password" title="Show / hide password">
                <svg class="i-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="i-eyeoff" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><path d="M1 1l22 22"/></svg>
              </button>
            <% } else { %><span class="muted" title="Changed by the owner, or created before this feature. Use Reset password to set a new one.">Not available</span><% } %>
          </td>
          <td data-label="Plan">
            <% if (!r.plan_expires) { %><span class="chip">One time</span>
            <% } else { %><span class="chip <%= expired ? 'warn' : '' %>"><%= expired ? 'Expired ' : 'Until ' %><%= r.plan_expires %></span><% } %>
          </td>
          <td data-label="Paid"><%= r.price_paid %></td>
          <td data-label="Items"><%= r.item_count %></td>
          <td data-label="Status">
            <form method="post" action="/admin/restaurants/<%= r.id %>/toggle" class="sw-form"
                  data-confirm="<%= r.active ? 'Make ' + r.name + ' inactive?' : 'Activate ' + r.name + '?' %>"
                  data-confirm-text="<%= r.active ? 'Its menu will stop working and the owner will not be able to log in.' : 'Its menu and the owner login will start working again.' %>"
                  data-confirm-ok="<%= r.active ? 'Make inactive' : 'Activate' %>"
                  data-confirm-tone="<%= r.active ? 'danger' : 'brand' %>">
              <button class="sw <%= r.active ? 'on' : '' %>" role="switch" aria-checked="<%= r.active %>"
                      aria-label="<%= r.active ? 'Active, click to deactivate' : 'Inactive, click to activate' %>"><i></i></button>
              <span class="<%= r.active ? 'sw-on' : 'sw-off' %>"><%= r.active ? 'Active' : 'Inactive' %></span>
            </form>
          </td>
          <td data-label="Actions">
            <div class="row-actions">
              <a class="btn ghost sm" href="/admin?edit=<%= r.id %>">Edit</a>
              <form method="post" action="/admin/restaurants/<%= r.id %>/reset-password"
                    data-confirm="Reset password for <%= r.name %>?" data-confirm-text="A new password is generated and shown once. The old password stops working immediately."
                    data-confirm-ok="Reset password" data-confirm-tone="brand"><button class="ghost sm">Reset password</button></form>
              <form method="post" action="/admin/restaurants/<%= r.id %>/delete"
                    data-confirm="Delete <%= r.name %>?" data-confirm-text="This permanently removes the restaurant, its owner login and all its menu items and photos. This cannot be undone."
                    data-confirm-ok="Delete" data-confirm-tone="danger"><button class="danger sm">Delete</button></form>
            </div>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </section>
</main>

<script src="/confirm.js"></script>
<script>
// copy the one-time login details to share with the owner
const cc=document.getElementById('copycreds');
cc&&cc.addEventListener('click',()=>{
  const g=id=>{const e=document.getElementById(id);return e?e.textContent:''};
  const text=['Login: '+g('c-url'),'Mobile: '+g('c-mobile'),g('c-email')&&'Email: '+g('c-email'),'Password: '+g('c-pass')].filter(Boolean).join('\n');
  (navigator.clipboard?navigator.clipboard.writeText(text):Promise.reject()).catch(()=>{const t=document.createElement('textarea');t.value=text;document.body.appendChild(t);t.select();document.execCommand('copy');t.remove();});
  cc.textContent='Copied';setTimeout(()=>cc.textContent='Copy details',1500);});

// onboarding popup. If the page loaded in edit/new/error state the popup opens on load and
// closing it returns to the clean list, so a stale edit form never lingers.
const dlg=document.getElementById('onboard-dlg'),stateful=<%= formOpen %>;
document.getElementById('open-onboard').addEventListener('click',()=>dlg.showModal());
dlg.addEventListener('click',e=>{if(e.target===dlg)dlg.close();});
dlg.querySelectorAll('[data-dlg-close]').forEach(b=>b.addEventListener('click',()=>dlg.close()));
dlg.addEventListener('close',()=>{if(stateful)location.href='/admin';});
if(stateful)dlg.showModal();

// eye button: fetch this owner's password on demand, auto-hide after 30s
function hidePw(b){const t=document.getElementById('pw-'+b.dataset.id);t.textContent='••••••••';t.classList.remove('shown');
  b.setAttribute('aria-pressed','false');b.setAttribute('aria-label','Show password');b.classList.remove('on');clearTimeout(b._t);}
document.querySelectorAll('.eye').forEach(b=>b.addEventListener('click',async()=>{
  if(b.getAttribute('aria-pressed')==='true')return hidePw(b);
  const t=document.getElementById('pw-'+b.dataset.id);b.disabled=true;
  try{
    const r=await fetch('/admin/restaurants/'+b.dataset.id+'/reveal-password',{method:'POST',headers:{Accept:'application/json'}});
    const j=await r.json();if(!r.ok||!j.password)throw 0;
    t.textContent=j.password;t.classList.add('shown');b.setAttribute('aria-pressed','true');b.setAttribute('aria-label','Hide password');b.classList.add('on');
    b._t=setTimeout(()=>hidePw(b),30000);
  }catch{t.textContent='Unavailable';setTimeout(()=>hidePw(b),1800);}
  b.disabled=false;}));

// plan: only "Limited" shows (and requires) the valid-until date
const wrap=document.getElementById('validwrap'),date=document.getElementById('plan_expires');
document.querySelectorAll('input[name=plan_type]').forEach(r=>r.addEventListener('change',()=>{
  const lim=document.querySelector('input[name=plan_type]:checked').value==='limited';
  wrap.style.display=lim?'':'none';date.required=lim;if(!lim)date.value='';
  document.getElementById('planhint').textContent=lim?'Menu stops working after the valid-until date.':'One-time plans never expire.';}));
// password: generate a random one / copy it
const pw=document.getElementById('password');
document.getElementById('genpw').addEventListener('click',()=>{
  const c='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789',a=new Uint32Array(12);crypto.getRandomValues(a);
  pw.value=Array.from(a,n=>c[n%c.length]).join('');pw.focus();pw.select();});
document.getElementById('cppw').addEventListener('click',e=>{
  if(!pw.value)return;pw.select();
  (navigator.clipboard?navigator.clipboard.writeText(pw.value):Promise.reject()).catch(()=>document.execCommand('copy'));
  e.target.textContent='Copied';setTimeout(()=>e.target.textContent='Copy',1500);});
</script>
</body></html>
